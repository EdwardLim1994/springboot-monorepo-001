extend schema @link(url: "https://specs.apollo.dev/federation/v2.11", import: ["@key"])

type Query {
  orders: [Order!]!
}

type Mutation {
  createOrder(productId: ID!, quantity: Int!): Order!
}

type Order {
  id: ID!
  productId: ID!
  quantity: Int!
  product: Product!
}

type Product @key(fields: "id") {
  id: ID!
}
